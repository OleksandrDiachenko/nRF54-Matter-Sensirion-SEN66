mainmenu "SEN66 Matter Air Quality Accessory"

config CHIP_WIFI

config APP_SEN66
	bool "Enable the SEN66 air-quality sensor driver"
	default y
	depends on I2C
	help
	  Build the isolated SEN66 I2C driver (transport, Sensirion CRC, and the
	  measurement/serial-number parser). Disabling it drops the driver sources
	  from the image without touching the Matter baseline.

config APP_SEN66_SHELL
	bool "Enable SEN66 diagnostic shell commands"
	default y
	depends on APP_SEN66 && SHELL
	help
	  Register the "sen66" shell command (serial, read, latest) used as the
	  M2/M3 hardware smoke test over the Matter shell.

config APP_MEASUREMENT_SERVICE
	bool "Enable the SEN66 measurement service"
	default y
	depends on APP_SEN66
	help
	  Poll the SEN66 on a dedicated work queue roughly once a second,
	  retry/recover from I2C and CRC errors, and expose a thread-safe
	  latest-measurement snapshot for later Matter integration.

config APP_MEASUREMENT_SERVICE_STACK_SIZE
	int "Measurement service work-queue stack size"
	default 2048
	depends on APP_MEASUREMENT_SERVICE
	help
	  Stack size for the dedicated work-queue thread that polls the SEN66
	  driver. The driver performs blocking I2C calls and logging on this
	  thread, so it needs headroom beyond a minimal work queue.

config APP_AIR_QUALITY_ENDPOINT
	bool "Enable the Matter air-quality sensor endpoint"
	default y
	depends on APP_MEASUREMENT_SERVICE
	help
	  Define endpoint 1 (Air Quality, Temperature/Humidity Measurement, and
	  CO2/PM1/PM2.5/PM10 Concentration Measurement) and publish it from the
	  measurement service's latest snapshot, marshaled onto the CHIP thread.

source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.features"
source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.defaults"
source "$(ZEPHYR_NRF_MODULE_DIR)/samples/matter/common/src/Kconfig"
source "Kconfig.zephyr"
